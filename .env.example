# PrizePicksAPI — copy to .env.local and fill in. Never commit secrets.

# --- The Odds API (https://the-odds-api.com/) ---
# THE_ODDS_API_KEY=

# --- xAI Grok (web_search + x_search) https://console.x.ai ---
# XAI_API_KEY=
# GROK_API_KEY=                  # alias for XAI_API_KEY
# GROK_MODEL=grok-4.7
# XAI_USD_PER_RESEARCH=          # required before --max-grok-spend allows calls

# --- PrizePicks board access ---
# PRIZEPICKS_BROWSER_COOKIE=

# --- Optional: S3 cache / publish pages (same AWS names as Dropflow) ---
# STATICS_AWS_ACCESS_KEY_ID=
# STATICS_AWS_SECRET_ACCESS_KEY=
# STATICS_AWS_REGION=us-east-1
# DROPFLOW_CDN_BASE_URL=
# NEXT_PUBLIC_DROPFLOW_APP_URL=http://localhost:3001

# --- Optional: Kalshi / Polymarket for prizepicks:edge ---
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY=
# POLYMARKET_ENABLED=true
